    # k normal "{cps=40}\"O que te fez se transferir para cá?\"{/cps}"
    k normal "{cps=40}\"What made you transfer here?\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:826
translate english encontrostella_8e956382_1:

    # s happy1 "{cps=40}\"Ah, é uma longa história... Mas resumindo bastante, eu tive alguns problemas na minha antiga escola, e eu precisava de um recomeço, então meus pais decidiram me transferir pra cá...\"{/cps}"
    s happy1 "{cps=40}\"Ah, it's a long story... But to sum it up, I had some problems at my old school, and I needed a fresh start, so my parents decided to transfer me here...\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:827
translate english encontrostella_50026cb5:

    # k normal "{cps=40}\"Ah, entendi... Bom, espero que aqui seja um bom recomeço pra você então...\"{/cps}"
    k normal "{cps=40}\"Ah, I see... Well, I hope this ends up being a good fresh start for you...\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:830
translate english encontrostella_5605f1a0_1:

    # s feliz "{cps=40}\"Obrigada Kioku, eu espero que sim também...\"{/cps}"
    s feliz "{cps=40}\"Thank you, Kioku. I hope so too...\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:833
translate english encontrostella_2043f75d_1:

    # k normal "{cps=40}\"Estella... Que nome bonito, é diferente.\"{/cps}"
    k normal "{cps=40}\"Estella... What a pretty name. It's different.\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:836
translate english encontrostella_80aafbdb:

    # s happy1 "{cps=40}\"Obrigada Kioku, é sim diferente, na verdade, não sou japonesa, eu sou brasileira!\"{/cps}"
    s happy1 "{cps=40}\"Thank you, Kioku. It is different. Actually, I'm not Japanese, I'm Brazilian!\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:837
translate english encontrostella_abfffb6b_1:

    # k surpreso "{cps=40}\"Nossa que legal, mas você nasceu no Japão?\"{/cps}"
    k surpreso "{cps=40}\"Wow, that's cool. But were you born in Japan?\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:840
translate english encontrostella_69240d19_1:

    # s envergonhada "{cps=40}\"Sim, mas meus pais são brasileiros, eles vieram para cá quando eu ainda não tinha nascido haha...\"{/cps}"
    s envergonhada "{cps=40}\"Yes, but my parents are Brazilian. They came here before I was born, haha...\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:841
translate english encontrostella_d91a1c11_1:

    # k feliz "{cps=40}\"Ah, entendi... Que legal, deve ser uma experiência interessante crescer aqui com uma cultura tão diferente da dos seus pais...\"{/cps}"
    k feliz "{cps=40}\"Ah, I see... That's cool. It must be an interesting experience, growing up here with a culture so different from your parents'...\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:844
translate english encontrostella_781c6644_1:

    # s feliz "{cps=40}\"É, não conheço muito a cultura brasileira, mas eu gosto bastante, e meus pais sempre me contam sobre o Brasil, e me ensinam um pouco de português...\"{/cps}"
    s feliz "{cps=40}\"Yeah, I don't know Brazilian culture that much, but I really like it, and my parents always tell me about Brazil and teach me a little Portuguese...\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:846
translate english encontrostella_54a02aad:

    # k feliz "{cps=40}\"Bom que tal eu começar o Tour pela Faculdade, o que acha?\"{/cps}"
    k feliz "{cps=40}\"Well, how about I start the college tour? What do you think?\"{/cps}"

# game/Arco1/capitulo1.3_escola.rpy:849
translate english encontrostella_7d5df549_1:

    # s happy1 "{cps=40}\"Ah, sim, claro, eu adoraria conhecer a Faculdade...\"{/cps}"
    s happy1 "{cps=40}\"Ah, yes, of course. I'd love to get to know the college...\"{/cps}"

