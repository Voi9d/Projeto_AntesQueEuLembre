# game/Arco1/capitulo1.3_escola.rpy:161
translate english discussaoatraso_3ccdd699:

    # k normal "{cps=40}{i}Vou correr para a sala de aula o mais rápido possível, quem sabe eu consiga chegar a tempo.{/i}{/cps}{nw}"
