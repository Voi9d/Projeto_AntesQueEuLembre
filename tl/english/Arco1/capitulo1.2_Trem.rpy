# game/Arco1/capitulo1.2_Trem.rpy:50
translate english tremestacao_b2654d2e:

    # "{cps=40}Kioku olha ao redor e vê que o seu trem começa a fechar as portas, Kioku sente que pode arriscar tudo e tentar de alguma forma adentrar na porta antes que ela feche.{/cps}"
    "{cps=40}Kioku looks around and sees his train starting to close its doors. He feels like he could risk everything and somehow get through the doors before they shut.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:59
translate english tremestacao_55ab629d:

    # "{cps=40}Kioku corre em direção ao trem, e com um salto impressionante, ele consegue entrar no trem antes que as portas se fechassem completamente.{/cps}"
    "{cps=40}Kioku runs toward the train and, with an impressive leap, manages to get inside before the doors close completely.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:64
translate english tremestacao_4e7bec0b:

    # "{cps=40}Você é muito sortudo ein, nossa, o Kioku ta nas mãos certas mesmo.{/cps}"
    "{cps=40}You're really lucky, huh. Wow, Kioku really is in the right hands.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:65
translate english tremestacao_4c6f483f:

    # k normal "{cps=40}\"Ufa... consegui entrar no trem... nossa senhora, senti minha vida passando pelos meus olhos.... 1 erro ali e era morte na certa.\"{/cps}"
    k normal "{cps=40}\"Phew... I made it onto the train... God, I saw my life flash before my eyes... One mistake there and I was definitely dead.\"{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:66
translate english tremestacao_d252bd5c:

    # k normal "{cps=40}{i}Não tem nenhum assento livre, que merda, bom, vou tentar descansar de pé aqui, e me escorrar nessa parede, espero que não freie bruscamente e eu caia no chão.\"{/i}{/cps}"
    k normal "{cps=40}{i}There aren't any seats free. Damn. Well, I'll try to rest standing here and lean against this wall. I hope the train doesn't brake suddenly and make me fall.\"{/i}{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:67
translate english tremestacao_855d49c5:

    # "{cps=40}Não se preocupem, isso não vai acontecer..................{/cps}"
    "{cps=40}Don't worry, that won't happen..................{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:71
translate english tremestacao_cfb1c290:

    # "{cps=40}Kioku corre em direção a porta do trem, tenta saltar antes dela fechar, mas ele bate de cara na porta, e o trem começa a sair.{/cps}"
    "{cps=40}Kioku runs toward the train door and tries to jump in before it closes, but he slams face-first into the door, and the train starts leaving.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:72
translate english tremestacao_670605b9:

    # "{cps=40}Kioku fica ali parado, vendo o trem se afastar, ele sente uma mistura de raiva e frustração, ele sabia que tinha que chegar a tempo, mas não conseguiu.{/cps}"
    "{cps=40}Kioku stands there, watching the train pull away. He feels a mix of anger and frustration. He knew he had to make it in time, but he couldn't.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:75
translate english tremestacao_2c5bde57:

    # k bravo "{cps=40}\"Merda... eu perdi o trem... que porra de dia é esse meu deus... agora vou me fuder na prova final... nossa senhora.\"{/cps}"
    k bravo "{cps=40}\"Shit... I missed the train... what the hell kind of day is this, God... now I'm screwed for the final exam... damn it.\"{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:76
translate english tremestacao_4851ae0f:

    # k bravo "{cps=40}{i}Foda-se... vou ter que esperar o próximo trem... que merda...{/i}{/cps}"
    k bravo "{cps=40}{i}Screw it... I'll have to wait for the next train... damn it...{/i}{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:77
translate english tremestacao_4a8addf0:

    # "{cps=40}Kioku então se afasta da plataforma, indo para a sala de espera, e se senta, esperando o próximo trem chegar.{/cps}"
    "{cps=40}Kioku then steps away from the platform and goes to the waiting room, sitting down to wait for the next train to arrive.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:78
translate english tremestacao_d6fb3b64:

    # "{cps=40}Depois de 30 minutos, o próximo trem chega, Kioku entra no vagão, e procura um assento vago para se sentar, e facilmente ele o encontra.{/cps}"
    "{cps=40}After 30 minutes, the next train arrives. Kioku enters the car and looks for an empty seat, and he finds one easily.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:81
translate english tremestacao_8d1eec27:

    # k bravo "{cps=40}{i}Finalmente consegui entrar no trem... eu espero que não me atrase muito na prova final... nossa senhora...{/i}{/cps}"
    k bravo "{cps=40}{i}I finally got on the train... I hope I'm not too late for the final exam... damn...{/i}{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:82
translate english tremestacao_8926a25b_1:

    # k normal "{cps=40}{i}Vou tentar descansar um pouco aqui, antes da prova...{/i}{/cps}"
    k normal "{cps=40}{i}I'll try to rest a little here before the exam...{/i}{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:89
translate english tremestacao_e5a44d82:

    # "{cps=40}Kioku vê que o trem está prestes a fechar as portas, e decide não arriscar sua vida tentando entrar na porta, ele se afasta da plataforma, indo para a sala de espera, e se senta, esperando o próximo trem chegar.{/cps}"
    "{cps=40}Kioku sees that the train is about to close its doors and decides not to risk his life trying to get in. He steps away from the platform, goes to the waiting room, and sits down to wait for the next train to arrive.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:90
translate english tremestacao_e6ee2477:

    # "{cps=40}Depois de 30 minutos, o próximo trem chega, Kioku entra no vagão, e procura um assento vago para se sentar, e facilmente ele o acha.{/cps}"
    "{cps=40}After 30 minutes, the next train arrives. Kioku enters the car and looks for an empty seat, and he finds one easily.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:93
translate english tremestacao_0db6bcdd:

    # k bravo "{cps=40}{i}Porra do caralho, vou me atrasar pra prova, que merda de dia é esse ein...{/i}{/cps}"
    k bravo "{cps=40}{i}Fuck, I'm going to be late for the exam. What the hell kind of day is this...{/i}{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:94
translate english tremestacao_8926a25b_2:

    # k normal "{cps=40}{i}Vou tentar descansar um pouco aqui, antes da prova...{/i}{/cps}"
    k normal "{cps=40}{i}I'll try to rest a little here before the exam...{/i}{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:99
translate english tremestacao_c96c887a:

    # "{cps=40}Kioku chega na estação de trem com tempo de sobra, ele entra no vagão, e procura um assento vago para se sentar, e rapidamente o encontra.{/cps}"
    "{cps=40}Kioku arrives at the train station with time to spare. He enters the car, looks for an empty seat, and quickly finds one.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:102
translate english tremestacao_16d24f12:

    # k normal "{cps=40}\"Ufa... consegui chegar a tempo, meu deus do céu... Deus é muito bom e o diabo não presta mesmo.\"{/cps}"
    k normal "{cps=40}\"Phew... I made it in time, dear God... Made it!\"{/cps}"

