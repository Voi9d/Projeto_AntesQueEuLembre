# game/Arco1/capitulo1.2_Trem.rpy:5
translate english tremestacao_42bd344f:

    # "{cps=40}Kioku segue em direção a estação de trem, tentando não se atrasar e perder o mesmo.{/cps}"
    "{cps=40}Kioku heads toward the train station, trying not to be late and miss it.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:6
translate english tremestacao_1e6bf85f:

    # "{cps=40}Ele sabe que se perder este trem, ele perde um dos períodos da prova final, e isso pode prejudicar sua nota na matéria.{/cps}"
    "{cps=40}He knows that if he misses this train, he'll miss one of the final exam periods, and that could hurt his grade in the class.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:16
translate english tremestacao_22156e64:

    # "{cps=40}Kioku começa a correr, e utilizar toda sua energia que tinha no corpo, ele sabia que se perdesse o trem, sua nota na prova final poderia ser prejudicada.{/cps}"
    "{cps=40}Kioku starts running, using every bit of energy left in his body. He knew that if he missed the train, his final exam grade could suffer.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:17
translate english tremestacao_b7c2a235:

    # "{cps=40}Kioku, então, pula a catraca, deixando alguns trocados para retribuir a passagem, começa a descer as escadas como um jato...{/cps}"
    "{cps=40}Kioku then jumps the turnstile, leaving a few coins behind to pay the fare, and starts rushing down the stairs like a jet...{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:20
translate english tremestacao_0eb4671e:

    # "{cps=40}Ele, então, chega na plataforma, olha para os lados e.....{/cps}"
    "{cps=40}He reaches the platform, looks around and.....{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:21
translate english tremestacao_e451ca4d:

    # "{cps=20}...{/cps}"
    "{cps=20}...{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:22
translate english tremestacao_e451ca4d_1:

    # "{cps=20}...{/cps}"
    "{cps=20}...{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:23
translate english tremestacao_8a1d9fd4:

    # "Maquinista" "{cps=40}\"Última chamada para o trem com destino a Universidade de Tokyo, embarque imediatamente.\"{/cps}"
    "Maquinista" "{cps=40}\"Last call for the train bound for the University of Tokyo. Please board immediately.\"{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:28
translate english tremestacao_45ab5331:

    # k normal "{cps=40}\"Puta merda, consegui chegar a tempo, meu deus do céu... Deus é muito bom e o diabo não presta nem um pouco nossa.\"{/cps}"
    k normal "{cps=40}\"Holy shit, I made it in time, dear God... That was close.\"{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:32
translate english tremestacao_a9c9e534:

    # "{cps=40}Kioku começa a vasculhar cada assento possível no vagão que estava e, por sorte, ele encontra um assento em um dos cantos do vagão (que sorte ein Kioku).\"{/cps}"
    "{cps=40}Kioku starts checking every possible seat in the car and, luckily, he finds one in the corner of the car. Lucky you, huh, Kioku?\"{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:33
translate english tremestacao_97e6c6c7:

    # k normal "{cps=40}\"Ai, ainda bem que achei um assento, nossa senhora, to exausto... Tenho que me exercitar mais, meu deus.\"{/cps}"
    k normal "{cps=40}\"Ah, thank God I found a seat. Damn, I'm exhausted... I really need to exercise more.\"{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:34
translate english tremestacao_8926a25b:

    # k normal "{cps=40}{i}Vou tentar descansar um pouco aqui, antes da prova...{/i}{/cps}"
    k normal "{cps=40}{i}I'll try to rest a little here before the exam...{/i}{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:37
translate english tremestacao_15a79a83:

    # "{cps=40}Kioku começa a vasculhar cada assento possível no vagão que estava, mas infelizmente não havia mais nenhum para ele poder sentar.{/cps}"
    "{cps=40}Kioku starts checking every possible seat in the car, but unfortunately there aren't any left for him to sit in.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:38
translate english tremestacao_6bd947d3:

    # k bravo "{cps=40}\"Puta merda cara, vou tem que ficar 30 minutos de pé agora... se eu tivesse chegado um pouco mais cedo...\"{/cps}"
    k bravo "{cps=40}\"Shit, man, now I'll have to stand for 30 minutes... if only I'd gotten here a little earlier...\"{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:39
translate english tremestacao_3c311cf6:

    # k normal "{cps=40}{i}Vou tentar descansar um pouco aqui em pé, antes da prova, espero que não freie bruscamente e eu caia no chão...{/cps}"
    k normal "{cps=40}{i}I'll try to rest a little while standing here before the exam. I hope the train doesn't brake suddenly and make me fall...{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:40
translate english tremestacao_82d8df96:

    # "{cps=40}Não se preocupem, isso não vai acontecer{/cps}{cps=10}..................{/cps}"
    "{cps=40}Don't worry, that won't happen{/cps}{cps=10}..................{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:43
translate english tremestacao_8405a40d:

    # "{cps=40}Kioku começa a correr, utiliza toda a sua adrenalina, suas pernas começam a formigar, esse garoto nunca correu tanto na sua vida pra pegar um trem.{/cps}"
    "{cps=40}Kioku starts running, using all his adrenaline. His legs start tingling. This boy has never run so much in his life just to catch a train.{/cps}"

# game/Arco1/capitulo1.2_Trem.rpy:44
translate english tremestacao_674669ee:

    # "{cps=40}Ele salta a catraca da estação, deixando algumas moedas para trás como pagamento, começa a descer as escadas como um foguete...{/cps}"
    "{cps=40}He jumps the station turnstile, leaving a few coins behind as payment, and starts rushing down the stairs like a rocket...{/cps}"

