# The game starts here.

label start:


    # Show a background. This uses a placeholder by default, but you can
    # add a file (named either "bg room.png" or "bg room.jpg") to the
    # images directory to show it.

    # This shows a character sprite. A placeholder is used, but you can
    # replace it by adding a file named "eileen happy.png" to the images
    # directory.
    
    show narrador
    with pixellate

    "{cps=40}{i}{b}Opa, aqui é o Gabriel, o desenvolvedor de \"Antes que eu lembre\", se você ta lendo isso, quer dizer que 
    esta jogando a minha primeira Demo do meu jogo{/b}{/i}{/cps}"

    "{cps=40}{i}{b}Ela esta sendo feita 100\% feita por mim, e por não ter muitos recursos, acabei utilizando personagens e fundos gratuitos compartilhados na internet{/b}{/i}{/cps}"

    "{cps=40}{i}{b}Ao final da Demo estará todos os créditos aos mesmo{/b}{/i}{/cps}"

    "{cps=40}{i}{b}Espero que goste desta Demo, e não se preocupe que num futuro próximo teremos atualização da Demo{/b}{/i}{/cps}"

    "{cps=40}{i}{b}Durante a gameplay desta Demo, algumas escolhas terão consequências, então pense bem, pois o seu futuro será julgado...{/b}{/i}{/cps}"

    "{cps=40}{i}{b}Muito obrigado, e bom jogo a você.{/b}{/i}{/cps}"

    stop music fadeout 1.0
    play music "audio/frozen_winter.mp3" fadein 1.0
    
    scene Ato1
    with dissolve

    # These display lines of dialogue.

    

    k "{cps=40}{i}Mesmo passando tanto tempo, eu as vezes penso sobre...{/i}{/cps}"
    
    # Diminui o volume da música para 30% quando o alarme tocar
    $ renpy.music.set_volume(0.3, delay=0.5, channel='music')
    play sound "alarme.mp3"
    pause 0.25

    scene Quarto1
    with pixellate
    
    # Restaura o volume da música para 100%
        
    
    pause 1.0

    stop audio fadeout 0.5
    
    $ renpy.music.set_volume(1.0, delay=1.0, channel='music')

    k normal "{cps=40}\"Que saco esse despertador, eu tenho que desativar essa merda se quiser dormir mais\"{/cps}"

    play audio "celularvibrando.mp3"
    pause 1.0
    

    k normal "{cps=40}\"Quem ta me ligando as 8 da manhã....\"{/cps}"
    stop audio fadeout 0.5
    k normal "{cps=40}\"Porque a Jinsei ta me ligando essa hora, meu deus do céu\"{/cps}"
    k normal "{cps=20}\"Oi Jinsei c-{nw}"
    pause 0.5
    j sorisso "{cps=40}\"Boooooooom diaaaaaaaa Kioku...\"{/cps}"
    j encantadaf "{cps=40}\"Como você tá Kiokuzinho? Dormiu bem?\"{/cps}"

    menu:
        "O mesmo de sempre sabe como é":
            jump omesmodesempre
        "To bem, fui acordado pelo despertador de novo":
            jump acordadodespertador
        "Ficar em Silêncio":
            jump silencio

label omesmodesempre:

    k normal "{cps=40}\"Ah... sabe como é, o mesmo de sempre...{/cps}\""
    j sorisso "{cps=40}\"Ah me conta mais vai, se parece que acordou meio mal{/cps}\""
    jump contar_verdade

label contar_verdade:
    menu:
        "Contar a verdade":
            $ jinseiamizade += 5
            k normal "{cps=40}\"Na verdade Jinsei, to meio mal... não sei explicar direito...{/cps}\""
            j choro "{cps=40}\"Ah... quer conversar sobre isso?{/cps}\""
            k normal "{cps=40}\"Não sei se quero falar sobre isso... são coisas complicadas...{/cps}\""
            j choro "{cps=40}\"Tudo bem Kioku, se quiser conversar sobre isso, eu to aqui{/cps}\""
            k "{cps=40}{i}Eu sinto que a Jinsei é a única pessoa que eu posso confiar hoje em dia, não devo esconder isso a ela, vou contar o que sonhei{/i}{/cps}"
            k normal "{cps=40}\"Na verdade eu sonhei com aquele garoto de novo... o Kioku de 10 anos atrás...{/cps}\""
            j surpresa "{cps=40}\"Sério? E o que aconteceu?{/cps}\""
            scene sonhokioku
            with dissolve
            show kiokujovem at center:
                zoom 0.65
            with fade
            k normal "{cps=40}\"Não falou nada, apenas ficou lá me olhando... Como se pudesse me ver{/cps}\""
            k normal "{cps=40}\"Eu tava num lugar estranho, era completamente escuro, com apenas algumas fumaças brancas{/cps}\""
            k normal "{cps=40}\"Eu tentei falar com ele, mas ele não respondia...{/cps}\""
            k normal "{cps=40}\"A única coisa que ele fazia era me olhar... como se quisesse me dizer algo...{/cps}\""
            hide kiokujovem
            show kiokujovemf at center:
                zoom 0.65
            k normal "{cps=40}\"Até que ele abriu sua boca, como se tivesse falando algo.... mas parecia que não saia nada{/cps}\""
            k normal "{cps=40}\"De repente eu acordei... me sentindo estranho... como se algo tivesse mudado dentro de mim...{/cps}\""
            hide kiokujovemf
            scene Quarto1
            with dissolve
            j choro "{cps=40}\"Nossa Kioku... deve ser difícil lidar com isso...{/cps}\""
            k normal "{cps=40}\"É... eu não sei o que fazer...{/cps}\""
            j sorisso "{cps=40}\"Ei, eu to aqui pra te ajudar no que for preciso, ok?{/cps}\""
            j sorisso "{cps=40}\"Você não tá sozinho nessa Kioku{/cps}\""
            k normal "{cps=40}\"Eu sei disso Jinsei... obrigado por estar do meu lado{/cps}\""
            j sorissof "{cps=40}\"Obrigado por me contar isso, Kioku, eu me sinto honrada por você confiar em mim{/cps}\""
            k "{cps=40}{i}Fazia um tempo que eu não me sentia assim, acolhido por alguém...{/i}{/cps}"
            k feliz "{cps=40}\"Obrigado Jinsei... você é uma ótima amiga{/cps}\""
            j encantadaf "{cps=40}\"Ah que fofo Kioku, você também é um ótimo amigo{/cps}\""
            j sorisso "{cps=40}\"Ei, mudando de assunto...{/cps}\""
            jump prova

        "Arrumar uma desculpa":
            $ jinseiamizade -= 5
            k normal "{cps=40}\"Ah... é que to meio cansado sabe, ando tendo uns sonhos estranhos...{/cps}\""
            j choro "{cps=40}\"Sonhos estranhos? Que tipo de sonhos?{/cps}\""
            k normal "{cps=40}\"Ah... é melhor nem falar sobre isso...{/cps}\""
            j choro "{cps=40}\"Ah... se quiser conversar sobre isso, eu to aqui{/cps}\""
            k normal "{cps=40}\"Obrigado Jinsei... mas é melhor eu não falar sobre isso...{/cps}\""
            j sorisso "{cps=40}\"Tudo bem Kioku, se quiser conversar sobre...{/cps}\""
            k "{cps=40}{i}Eu não quero envolver a Jinsei nisso, é melhor eu não contar nada pra ela{/i}{/cps}"
            j sorisso "{cps=40}\"Ei, mudando de assunto...{/cps}\""
            jump prova

return

label acordadodespertador:

    k normal "{cps=40}\"Ah... To bem, única coisa é que fui acordado pelo despertador.... de novo\"{/cps}"
    j encantadaf "{cps=40}\"Bom pelo menos alguem consegue te acordar hahahahaha{/cps}\""
    k divertindo "{cps=40}\"Hahahaha, tem razão, mas sei la, hoje queria dormir mais{/cps}\""
    j normal "{cps=40}\"Mas, pela sua voz, você parece meio mal{/cps}\""
    k normal "{cps=40}\"Ah não é nada de mais, não precisa se preocupar com isso{/cps}\""
    j surpresa "{cps=40}\"Pode confiar em mim Kioku, o que aconteceu?{/cps}\""
    jump contar_verdade

return

label silencio:

    k normal "{cps=40}\"....{/cps}\""
    j choro "{cps=40}\"Sonhou com aquilo de novo né?{/cps}\""
    k triste "{cps=40}\"....{/cps}\""
    k "{cps=40}{i}Aquele silêncio parece ter sido durado um século, porque sempre que toca nesse assunto é assim{/i}{/cps}"
    jump contar_verdade


label prova:
    j sorisso "{cps=40}\"Estudou para prova de hoje?{/cps}\""
    k surpreso "{cps=40}\"Era hoje?{/cps}\""
    j surpresa "{cps=40}\"Sim era hoje{/cps}\""
    j seachando "{cps=40}\"Meu deus do céu Kioku...{/cps}\""
    k divertindo "{cps=40}\"Você devia ter visto sua cara hahahahaha{/cps}\""
    j bravanime ""
    k superfeliz "{cps=40}\"Aiai, me tirou boas risadas..{/cps}\""
    k feliz "{cps=40}\"Estudei sim Jinsei, pode ficar tranquila{/cps}\""

    k "{cps=40}{i}Naquela hora eu tinha me lembrado como era sorrir novamente, pelo menos por pouco tempo, eu me senti alegre{/i}{/cps}"

    j sorisso "..."
    j encantada "{cps=40}\"Você tem um lindo sorriso, sabia Kioku{/cps}\""

    k normal "..."
    k "{cps=40}{i}Eu não sabia o que responder pra ela, ela nunca tinha me elogiado assim antes{/i}{/cps}"

    j bravanime "{cps=40}\"Af... você tava melhor sorrindo Kioku, você tem que sorrir mais{/cps}\""
    k normal "{cps=40}\"Não sei não, to bem assim do jeito que sou...{/cps}\""
    j sorisso "{cps=40}\"Bem, eu vou tomar um banho, tomar café, e ir pra escola, beijinhos{/cps}\""
    j encantadaf "{cps=40}\"Não vai se atrasar ein Kioku{/cps}\""

    k "{cps=40}{i}Eu desligo o telefone, e é como se aquele sorriso tivesse voltado pro meu rosto{/i}{/cps}"
    k "{cps=40}{i}A única que sempre me apoiou e ficou do meu lado nesses últimos 10 anos foi a Jinsei{/i}{/cps}"
    k "{cps=40}{i}Acho que é por isso que me sinto a vontade com ela por perto, e as vezes até sorrio por impulso{/i}{/cps}"
    k "{cps=40}{i}Ta não vamo enrolar, ja é 8 horas e 15, o trêm chega as 8 e 40, tenho 15 minutos pra sair de casa{/i}{/cps}"

    k "{cps=40}{i}Eu posso fazer duas coisas só, e agora o que eu faço velho, porra me perdi no tempo conversando com a Jinsei{/i}{/cps}"

    menu:
        "Escovar os Dentes":
            $ dentesprimeiro = True
            jump escovardente
        "Tomar banho":
            $ banhoprimeiro = True
            jump tomarbanho
        "Tomar café":
            $ tomarcafeprimeiro = True
            jump cafemanha
        "Alimentar o Mingau":
            $ mingaualimentadoprimeiro = True
            jump alimentarmingau

label escovardente:
    scene banheiroap
    with pixellate
    k normal "{cps=40}{i}Ok, vou escovar meus dentes rapidinho{/i}{/cps}"
    k bravo "{cps=40}\"Mas que merda cara, que dificuldade de tirar a pasta velho, ja dobrei toda a bisnaga e nada de sair essa porra{/cps}\""

    # Inicia o minigame (20 cliques em 5s)
    $ pasta_clicks = 0
    $ pasta_time_left = 5
    call screen minigame_pasta
    if _return:
        k feliz "{cps=40}{i}Finalmente! Consegui tirar a pasta meu deus. Nossa doeu minha mãe fazendo isso, depois da faculdade vou comprar uma pasta nova{/i}{/cps}"
        scene narrador
        with dissolve
        play audio "audio/escovardente.mp3"
        pause 5.0
        scene banheiroap
        with dissolve
    else:
        k bravo "{cps=40}{i}Que merda... não consegui tirar a pasta. Que saco, assim vou me atrasar, depois escovo os dentes{/i}{/cps}"

    if dentesprimeiro == True:
        if pasta_clicks >= 20:
            k feliz "{cps=40}{i}Agora que escovei meus dentes, eu posso ainda fazer mais uma coisa antes de sair{/i}{/cps}"
            menu:
                "Tomar banho":
                    $ banhosegundo = True
                    jump tomarbanho
                "Tomar café":
                    $ tomarcafesegundo = True
                    jump cafemanha
                "Alimentar o Mingau":
                    $ mingaualimentadosegundo = True
                    jump alimentarmingau
        else:
            k "{cps=40}{i}Mesmo não tendo escovado os dentes, eu posso ainda fazer mais uma coisa antes de sair{/i}{/cps}"
            menu:
                "Tomar banho":
                    $ banhosegundo = True 
                    jump tomarbanho
                "Tomar café":
                    $ tomarcafesegundo = True
                    jump cafemanha
                "Alimentar o Mingau":
                    $ mingaualimentadosegundo = True
                    jump alimentarmingau
    elif dentesegundo == True and (banhoprimeiro == True or tomarcafeprimeiro == True or mingaualimentadoprimeiro == True):
        k "{cps=40}{i}Agora sim, estou pronto pra sair de casa{/i}{/cps}"
        jump sairdecasa

label tomarbanho:
    scene banheiroap
    with pixellate
    k normal "{cps=40}{i}Ok, vou tomar um banho rápido, pra não me atrasar{/i}{/cps}"
    scene narrador
    with dissolve
    play audio "tomarbanho.mp3"
    k feliz "{cps=40}{i}Ahhh... que delícia, água morna... isso é vida{/i}{/cps}"
    scene banheiroapbanho
    stop audio fadeout 0.5
    with dissolve

    if banhoprimeiro == True:
        k "{cps=40}{i}Agora que tomei banho, eu posso ainda fazer mais uma coisa antes de sair{/i}{/cps}"
        menu:
            "Escovar os Dentes":
                $ dentesegundo = True
                jump escovardente
            "Tomar café":
                $ tomarcafesegundo = True
                jump cafemanha
            "Alimentar o Mingau":
                $ mingaualimentadosegundo = True
                jump alimentarmingau
    elif banhosegundo == True and (dentesprimeiro == True or tomarcafeprimeiro == True or mingaualimentadoprimeiro == True):
        k "{cps=40}{i}Agora sim, estou pronto pra sair de casa{/i}{/cps}"
        jump sairdecasa

label cafemanha:
    scene cozinhaap
    with pixellate
    k feliz "{cps=40}{i}Ok, vou tomar um café rápido, pra não me atrasar, cafézin preto com aquele sanduba de pão de forma....{/i}{/cps}"
    k normal "{cps=40}\"Mano.... Cade o pão? Não é possível que eu tenha esquecido de comprar pão de forma ontem né{/cps}\""
    call rolar_d20 (dc=10, modifier=0, titulo="Teste de 'será que eu esqueci de comprar o pão?'") from _call_rolar_d20
    $ resultado = _return
    if resultado:
        k feliz "{cps=40}{i}Ahhh, graças a deus, eu comprei, não vou passar fome{/i}{/cps}"
    else:
        k bravo "{cps=40}{i}Merda, eu esqueci de comprar pão de forma ontem... agora vou ter que ir pra faculdade sem comer nada{/i}{/cps}"
    

    if tomarcafeprimeiro == True:
        if resultado:
            k "{cps=40}{i}Agora que tomei meu café, eu posso ainda fazer mais uma coisa antes de sair{/i}{/cps}"
            menu:
                "Escovar os Dentes":
                    $ dentesegundo = True
                    jump escovardente
                "Tomar banho":
                    $ banhosegundo = True
                    jump tomarbanho
                "Alimentar o Mingau":
                    $ mingaualimentadosegundo = True
                    jump alimentarmingau
        else:
            k "{cps=40}{i}Vou tomar só um café mesmo não preciso do pão.{/i}{/cps}"
            k "{cps=40}{i}Mas enfim, eu posso ainda fazer mais uma coisa antes de sair{/i}{/cps}"
            menu:
                "Escovar os Dentes":
                    $ dentesegundo = True
                    jump escovardente
                "Tomar banho":
                    $ banhosegundo = True
                    jump tomarbanho
                "Alimentar o Mingau":
                    $ mingaualimentadosegundo = True
                    jump alimentarmingau
    elif tomarcafesegundo == True and (dentesprimeiro == True or banhoprimeiro == True or mingaualimentadoprimeiro == True):
        k "{cps=40}{i}Agora sim, estou pronto pra sair de casa{/i}{/cps}"
        jump sairdecasa
    



label alimentarmingau:
    scene sala
    with pixellate
    play audio "audio/minguauronronando.mp3"
    show mingaudormindo at center:
        zoom 0.5
    k feliz "{cps=40}{i}O Mingau é tão bonito dormindo, você é a unica coisa que ainda me faz sorrir nesse mundo amigão{/i}{/cps}"
    k feliz "{cps=40}{i}Vou alimentar você antes de sair, espera aí{/i}{/cps}"
    stop audio fadeout 0.5
    hide mingaudormindo
    play audio "audio/mingaumiando.mp3" fadeout 0.5
    show minguaufeliz
    with dissolve
    k feliz "{cps=40}\"Bom dia amigão, coloquei sua comida no pote, pode ir comer{/cps}\""
    k feliz "{cps=40}\"Eu vou sair agora pra ir pra faculdade, mas não se preocupa que eu volto mais tarde{/cps}\""
    k superfeliz "{cps=40}\"Tenta não fazer bagunça por aí ok? Hahahaha{/cps}\""
    play audio "audio/mingauresponde.mp3"
    k feliz "{cps=40}\"Eu te amo mingau, te vejo mais tarde amigão{/cps}\""
    play audio "audio/mingauvaicomer.mp3"
    hide minguaufeliz
    with dissolve

    if mingaualimentadoprimeiro == True:
        k "{cps=40}{i}Okay, agora que alimentei o Mingau, eu posso ainda fazer mais uma coisa antes de sair{/i}{/cps}"
        menu:
            "Escovar os Dentes":
                $ dentesegundo = True
                jump escovardente
            "Tomar banho":
                $ banhosegundo = True
                jump tomarbanho
            "Tomar café":
                $ tomarcafesegundo = True
                jump cafemanha
    elif mingaualimentadosegundo == True and (dentesprimeiro == True or banhoprimeiro == True or tomarcafeprimeiro == True):
        k "{cps=40}{i}Agora sim, estou pronto pra sair de casa{/i}{/cps}"
        jump sairdecasa      

label sairdecasa:
    scene narrador
    with dissolve
    play sound "audio/abrindoporta.mp3"
    pause 1.0
    play sound "audio/fechandoporta.mp3"
    scene apartamentoexterno
    with pixellate
    k "{cps=40}{i}Finalmente estou fora de casa, agora é só pegar o trêm e ir pra faculdade{/i}{/cps}"
    play audio "audio/batendonaporta.mp3"
    k "{cps=40}{i}Que barulho é esse?{/cps}{/i}"
    k "{cps=40}{i}Parece que vem lá da lavanderia do prédio...{/i}{/cps}"
    menu:
        "Investigar o barulho":
            jump investigarbarulho
        "Ignorar o barulho e seguir para a estação de trêm":
            jump tremestacao


label investigarbarulho:
    $ trematraso = True
    $ StellaAmizade = True 
    k "{cps=40}{i}Vou ver o que está acontecendo lá na lavanderia{/i}{/cps}"
    scene escadalavanderia
    with pixellate
    stop music fadeout 1.0
    play music "audio/Till Death Do Us Part.ogg" fadein 1.0
    k normal "{cps=40}\"Quem está aí? Precisa de ajuda?{/cps}\""
    show Stella normal
    with dissolve
    "???" "{cps=40}\"Ai meu deus, me ajuda por favor... eu estou presa aqui...{/cps}\""
    k normal "{cps=40}\"Presa... Você quer dizer, não conseguindo abrir a porta?{/cps}\""
    "???" "{cps=40}\"Sim, eu acho que a maçaneta quebrou... você pode me ajudar?{/cps}\""
    k normal "{cps=40}\"Claro, espera aí que eu vou tentar abrir pra você{/cps}\""
    k normal "{cps=40}{i}Deixa eu tentar abrir esta porta...{/i}{/cps}"
    k surpreso "{cps=40}{i}Calma ai.... essa porta tá trancada{/cps}{/i}"
    k normal "{cps=40}{i}Será que ela usou a chave que todos tem da lavanderia?{/i}{/cps}"
    k normal "{cps=40}{i}Deixa eu tentar usar a chave...{/i}{/cps}"
    k surpreso "{cps=40}{i}Consegui abrir a porta...{/cps}{/i}"
    k normal "{cps=40}{i}Espera ai, ela não tentou usar a chave?{/i}{/cps}"
    k normal "{cps=40}\"Pronto, a porta está aberta agora{/cps}\""
    hide Stella normal
    show Stella feliz
    "???" "{cps=40}\"Ai meu deus, muito obrigada... eu estava aqui presa a um tempão tentando abrir a porta pra levar minhas roupas pra lavar...{/cps}\""
    k normal "{cps=40}\"Imagina, que bom que consegui ajudar{/cps}\""
    k normal "{cps=40}\"Você não recebeu uma dessas chaves quando se mudou pra cá?{/cps}\""
    hide Stella feliz
    show Stella envergonhada
    "???" "{cps=40}\"Ah... eu acho que sim... eu devo ter perdido ela... em algum lugar..... do prédio{/cps}\""
    k feliz "{cps=40}\"Ah sim, entendo, inclusive, muito prazer sou Kioku Aida{/cps}\""
    hide Stella envergonhada
    show Stella feliz2
    s feliz2 "{cps=40}\"Muito prazer Kioku, eu sou Estella Nascimento, acabei de me mudar pra cá faz pouco tempo{/cps}\""
    k feliz "{cps=40}\"Que legal, seja bem vinda ao prédio então{/cps}\""
    show Stella smug
    s smug "{cps=40}\"Obrigada Kioku, eu espero me dar bem com todos aqui{/cps}\""
    menu:
        "Perguntar sobre o nome":
            $ stellaamizade += 10
            k normal "{cps=40}\"Estella, que nome bonito... de onde é esse nome?{/cps}\""
            hide Stella smug
            show Stella happy1
            s happy1 "{cps=40}\"Ah obrigada Kioku, na verdade é um nome português, meus pais são do Brasil{/cps}\""
            k feliz "{cps=40}\"Nossa que legal, eu sempre quis conhecer o Brasil um dia{/cps}\""
            hide Stella happy1
            show Stella happy2
            s happy2 "{cps=40}\"Você deveria mesmo Kioku, é um país lindo, cheio de praias, as comidas de lá são incriveis, o grande \'Churrasco\', bah nossa senhora{/cps}\""
            k feliz "{cps=40}\"Quem sabe um dia eu consiga ir lá visitar{/cps}\""
            hide Stella happy2
            show Stella feliz3
            s feliz3 "{cps=40}\"Com certeza Kioku, quando tu for eu levo você pra conhecer Porto Alegre, e conhecer o maior do Sul{/cps}\""
            k divertindo "{cps=40}\"Fechado então, não sei o que você quis dizer com \'maior do Sul\' mas é isso ai hahahahaha{/cps}\""
            hide Stella feliz3
            show Stella happy2
            s happy2 "{cps=40}\"Hahahaha, é um time de futebol, o Grêmio, o time que eu torço{/cps}\""
            k surpreso "{cps=40}\"Ah sim, eu não entendo muito de futebol, mas quem sabe você me ensina um dia{/cps}\""
            hide Stella happy2
            show Stella feliz3
            s feliz3 "{cps=40}\"Com certeza Kioku, e de brinde eu vou te levar pra assistir um jogo hahahaha{/cps}\""
            k divertindo "{cps=40}\"Fechado hahahaha{/cps}\""
            menu:
                "Se voluntariar a ajudar a encontrar a chave":
                    $ stellaamizade += 5
                    k normal "{cps=40}\"Estella, se você quiser eu posso te ajudar a procurar essa chave perdida{/cps}\""
                    hide Stella feliz3
                    show Stella happy1
                    s happy1 "{cps=40}\"Ah seria ótimo Kioku, muito obrigada mesmo{/cps}\""
                    k superfeliz "{cps=40}\"Imagina, vizinhos ajudam os outros{/cps}\""
                    hide Stella happy1
                    show Stella happy2
                    s happy2 "{cps=40}\"Com certeza, eu vou lavar minhas roupas primeiro{/cps}\""
                    hide Stella happy2
                    show Stella feliz
                    s feliz "{cps=40}\"Ai quando eu terminar de desfazer minhas malas, tudo que preciso fazer lá em cima, eu posso te chamar pra me ajudar?{/cps}\""
                    k feliz "{cps=40}\"Claro, ai quando eu voltar eu te ajudo com certeza{/cps}\""
                    hide Stella feliz
                    show Stella envergonhada
                    s envergonhada "{cps=40}\"Mas, meio que não tenho como me comunicar contigo, como a gente vai combinar o horário?{/cps}\""
                    k normal "{cps=40}{i}Ah sim, é verdade...{/i}{/cps}"
                    k normal "{cps=40}{i}O Ryota tem como avisar ela pelo interfone.... Ou eu passo o celular pra ela.... Será que ela vai achar muito estranho?{/i}{/cps}"
                    menu:
                        "Falar sobre o Ryota":
                            k normal "{cps=40}\"Olha Estella, tem o Porteiro que sempre ta pela salinha dele, o Ryota... ele pode te ajudar a avisar você quando eu chegar em casa{/cps}\""
                            hide Stella envergonhada
                            show Stella feliz2
                            s feliz2 "{cps=40}\"Ah que ótimo, muito obrigada Kioku, vou falar com o Ryota então após eu terminar aqui, e te espero mais tarde para me ajudar{/cps}\""
                            hide Stella feliz2
                            show Stella happy2
                            s happy2 "{cps=40}\"Não vai esquecer ein, hahahahaha{/cps}\""
                            k divertindo "{cps=40}\"Pode deixar hahahaha, tenho uma memória boa{/cps}\""

                        "Dar o número de celular":
                            $ stellacelular = True
                            $ stellaamizade += 5
                            k normal "{cps=40}\"Ah Estella, eu posso te passar meu número de celular, assim quando eu chegar em casa você me avisa por lá{/cps}\""
                            hide Stella envergonhada
                            show Stella feliz2
                            s feliz2 "{cps=40}\"Ah que ótimo, muito obrigada mesmo{/cps}\""
                            k superfeliz "{cps=40}\"Imagina, não precisa agradecer{/cps}\""
                            hide Stella feliz2
                            show Stella happy2
                            s happy2 "{cps=40}\"Bem qual seria seu número?{/cps}\""
                            k normal "{cps=40}\"Meu número é 1711-291117, pode me chamar por lá quando quiser{/cps}\""
                            hide Stella happy2
                            show Stella feliz2
                            s feliz2 "{cps=40}\"Ah que ótimo, muito obrigada Kioku, vou terminar aqui de lavar as roupas, depois de mando um oi{/cps}\""
                            k feliz "{cps=40}\"Tranquilo, sem pressa viu.{/cps}\""
                    k feliz "{cps=40}\"Bom, eu tenho que ir agora, senão vou me atrasar pra faculdade{/cps}\""
                    s feliz2 "{cps=40}\"Claro Kioku, muito obrigada por me ajudar com a porta{/cps}\""
                    k normal "{cps=40}\"Imagina, qualquer coisa que precisar é só me chamar{/cps}\""
                    hide Stella feliz2
                    scene narrador
                    with pixellate
                    k "{cps=40}{i}Faz tempo que não sorrio continuamente assim, acho que tem algo mudando...{/i}{/cps}"
                    k "{cps=40}{i}Se bem que a mãe sempre falava que eu tinha um bom coração, talvez seja isso...{/i}{/cps}"
                    k "{cps=40}{i}A Estella parece legal....{/i}{/cps}"
                    k divertindo "{cps=40}{i}Se a Jinsei descobrir que eu conversei com a Estella, ela vai ficar.....{/i}{/cps}"
                    show JinseiCbravanime at center
                    with fade
                    j bravanime "{cps=40}\"Kioku Aida! O que você pensa que está fazendo conversando com essa garota?!{/cps}\""
                    j bravanime "{cps=40}\"Você sabe que eu não gosto que você fale com outras garotas além de mim!{/cps}\""
                    hide JinseiCbravanime
                    with fade
                    scene apartamentoexterno
                    with pixellate
                    k divertindo "{cps=40}{i}Hahahahahahaha, a Jinsei sempre foi assim ciumenta, mas ela sabe que sempre vai ter um espaço pra ela, além do mais ela foi minha primeira amiga....{/i}{/cps}"
                    k triste "{cps=40}{i}...Ela foi a única que me apoiou e ficou comigo nesses últimos 10 anos...{/i}{/cps}"
                    k triste "{cps=40}{i}Sem ela não sei onde estaria hoje...{/i}{/cps}"
                    k normal "{cps=40}{i}EI Kioku, foca, você não precisa ficar remoendo isso, você já superou isso, e deve continuar assim, F O C O{/i}{/cps}"
                    menu:
                        "Ir para a estação de trêm":
                            jump tremestacao
                        "Voltar para o apartamento":
                            jump fimdemosecreto
                "Despedir-se e seguir para a estação de trêm":
                    $ stellaamizade += 5
                    k normal "{cps=40}\"Bom, eu tenho que ir agora{/cps}\""
                    hide Stella feliz3
                    show Stella feliz
                    s feliz "{cps=40}\"Claro Kioku, muito obrigada por me ajudar com a porta{/cps}\""
                    k normal "{cps=40}\"Imagina, qualquer coisa que precisar é só me chamar{/cps}\""
                    hide Stella feliz
                    scene narrador
                    with pixellate
                    k "{cps=40}{i}Faz tempo que não sorrio continuamente assim, acho que tem algo mudando...{/i}{/cps}"
                    k "{cps=40}{i}Se bem que a mãe sempre falava que eu tinha um bom coração, talvez seja isso...{/i}{/cps}"
                    k "{cps=40}{i}A Estella parece legal....{/i}{/cps}"
                    k divertindo "{cps=40}{i}Se a Jinsei descobrir que eu conversei com a Estella, ela vai ficar.....{/i}{/cps}"
                    show JinseiCbravanime at center
                    with fade
                    j bravanime "{cps=40}\"Kioku Aida! O que você pensa que está fazendo conversando com essa garota?!{/cps}\""
                    j bravanime "{cps=40}\"Você sabe que eu não gosto que você fale com outras garotas além de mim!{/cps}\""
                    hide JinseiCbravanime
                    with fade
                    k divertindo "{cps=40}{i}Hahahahahahaha, a Jinsei sempre foi assim ciumenta, mas ela sabe que sempre vai ter um espaço pra ela, além do mais ela foi minha primeira amiga....{/i}{/cps}"
                    k triste "{cps=40}{i}...Ela foi a única que me apoiou e ficou comigo nesses últimos 10 anos...{/i}{/cps}"
                    k triste "{cps=40}{i}Sem ela não sei onde estaria hoje...{/i}{/cps}"
                    k normal "{cps=40}{i}EI Kioku, foca, você não precisa ficar remoendo isso, você já superou isso, e deve continuar assim, F O C O{/i}{/cps}"
                    menu:
                        "Ir para a estação de trêm":
                            jump tremestacao
                        "Voltar para o apartamento":
                            jump fimdemosecreto
        "Se voluntariar a ajudar a encontrar a chave":
            $ stellaamizade += 5
            k normal "{cps=40}\"Estella, se você quiser eu posso te ajudar a procurar essa chave perdida{/cps}\""
            hide Stella feliz3
            show Stella happy1
            s happy1 "{cps=40}\"Ah seria ótimo Kioku, muito obrigada mesmo{/cps}\""
            k superfeliz "{cps=40}\"Imagina, vizinhos ajudam os outros{/cps}\""
            hide Stella happy1
            show Stella happy2
            s happy2 "{cps=40}\"Com certeza, eu vou lavar minhas roupas primeiro{/cps}\""
            hide Stella happy2
            show Stella feliz
            s feliz "{cps=40}\"Ai quando eu terminar de desfazer minhas malas, tudo que preciso fazer lá em cima, eu posso te chamar pra me ajudar?{/cps}\""
            k feliz "{cps=40}\"Claro, ai quando eu voltar eu te ajudo com certeza{/cps}\""
            hide Stella feliz
            show Stella envergonhada
            s envergonhada "{cps=40}\"Mas, meio que não tenho como me comunicar contigo, como a gente vai combinar o horário?{/cps}\""
            k normal "{cps=40}{i}Ah sim, é verdade...{/i}{/cps}"
            k normal "{cps=40}{i}O Ryota tem como avisar ela pelo interfone.... Ou eu passo o celular pra ela.... Será que ela vai achar muito estranho?{/i}{/cps}"
            menu:
                "Falar sobre o Ryota":
                    k normal "{cps=40}\"Olha Estella, tem o Porteiro que sempre ta pela salinha dele, o Ryota... ele pode te ajudar a avisar você quando eu chegar em casa{/cps}\""
                    hide Stella envergonhada
                    show Stella feliz2
                    s feliz2 "{cps=40}\"Ah que ótimo, muito obrigada Kioku, vou falar com o Ryota então após eu terminar aqui, e te espero mais tarde para me ajudar{/cps}\""
                    hide Stella feliz2
                    show Stella happy2
                    s happy2 "{cps=40}\"Não vai esquecer ein, hahahahaha{/cps}\""
                    k divertindo "{cps=40}\"Pode deixar hahahaha, tenho uma memória boa{/cps}\""
                "Dar o número de celular":
                    $ stellacelular = True
                    $ stellaamizade += 5
                    k normal "{cps=40}\"Ah Estella, eu posso te passar meu número de celular, assim quando eu chegar em casa você me avisa por lá{/cps}\""
                    hide Stella envergonhada
                    show Stella feliz2
                    s feliz2 "{cps=40}\"Ah que ótimo, muito obrigada mesmo{/cps}\""
                    k superfeliz "{cps=40}\"Imagina, não precisa agradecer{/cps}\""
                    hide Stella feliz2
                    show Stella happy2
                    s happy2 "{cps=40}\"Bem qual seria seu número?{/cps}\""
                    k normal "{cps=40}\"Meu número é 1711-291117, pode me chamar por lá quando quiser{/cps}\""
                    hide Stella happy2
                    show Stella feliz2
                    s feliz2 "{cps=40}\"Ah que ótimo, muito obrigada Kioku, vou terminar aqui de lavar as roupas, depois de mando um oi{/cps}\""
                    k feliz "{cps=40}\"Tranquilo, sem pressa viu.{/cps}\""
            menu:
                "Perguntar sobre o nome":
                    $ stellaamizade += 10
                    k normal "{cps=40}\"Estella, que nome bonito... de onde é esse nome?{/cps}\""
                    hide Stella envergonhada
                    show Stella happy1
                    s happy1 "{cps=40}\"Ah obrigada Kioku, na verdade é um nome português, meus pais são do Brasil{/cps}\""
                    k feliz "{cps=40}\"Nossa que legal, eu sempre quis conhecer o Brasil um dia{/cps}\""
                    hide Stella happy1
                    show Stella happy2
                    s happy2 "{cps=40}\"Você deveria mesmo Kioku, é um país lindo, cheio de praias, as comidas de lá são incriveis, o grande \'Churrasco\', bah nossa senhora{/cps}\""
                    k feliz "{cps=40}\"Quem sabe um dia eu consiga ir lá visitar{/cps}\""
                    hide Stella happy2
                    show Stella normal
                    s normal "{cps=40}\"Com certeza Kioku, quando tu for eu levo você pra conhecer Porto Alegre, e conhecer o maior do Sul{/cps}\""
                    k divertindo "{cps=40}\"Fechado então, não sei o que você quis dizer com \'maior do Sul\' mas é isso ai hahahahaha{/cps}\""
                    hide Stella Normal
                    show Stella happy2
                    s happy2 "{cps=40}\"Hahahaha, é um time de futebol, o Grêmio, o time que eu torço{/cps}\""
                    k surpreso "{cps=40}\"Ah sim, eu não entendo muito de futebol, mas quem sabe você me ensina um dia{/cps}\""
                    hide Stella happy2
                    show Stella feliz3
                    s feliz3 "{cps=40}\"Com certeza Kioku, e de brinde eu vou te levar pra assistir um jogo hahahaha{/cps}\""
                    k divertindo "{cps=40}\"Fechado hahahaha{/cps}\""
                    k feliz "{cps=40}\"Bom, eu tenho que ir agora, senão vou me atrasar pra faculdade{/cps}\""
                    hide Stella feliz3
                    show Stella feliz2
                    s feliz2 "{cps=40}\"Claro Kioku, muito obrigada por me ajudar com a porta{/cps}\""
                    k normal "{cps=40}\"Imagina, qualquer coisa que precisar é só me chamar{/cps}\""
                    hide Stella feliz2
                    scene narrador
                    with pixellate
                    k "{cps=40}{i}Faz tempo que não sorrio continuamente assim, acho que tem algo mudando...{/i}{/cps}"
                    k "{cps=40}{i}Se bem que a mãe sempre falava que eu tinha um bom coração, talvez seja isso...{/i}{/cps}"
                    k "{cps=40}{i}A Estella parece legal....{/i}{/cps}"
                    k divertindo "{cps=40}{i}Se a Jinsei descobrir que eu conversei com a Estella, ela vai ficar.....{/i}{/cps}"
                    show JinseiCbravanime at center
                    with fade
                    j bravanime "{cps=40}\"Kioku Aida! O que você pensa que está fazendo conversando com essa garota?!{/cps}\""
                    j bravanime "{cps=40}\"Você sabe que eu não gosto que você fale com outras garotas além de mim!{/cps}\""
                    hide JinseiCbravanime
                    with fade
                    scene apartamentoexterno
                    with pixellate
                    k divertindo "{cps=40}{i}Hahahahahahaha, a Jinsei sempre foi assim ciumenta, mas ela sabe que sempre vai ter um espaço pra ela, além do mais ela foi minha primeira amiga....{/i}{/cps}"
                    k triste "{cps=40}{i}...Ela foi a única que me apoiou e ficou comigo nesses últimos 10 anos...{/i}{/cps}"
                    k triste "{cps=40}{i}Sem ela não sei onde estaria hoje...{/i}{/cps}"
                    k normal "{cps=40}{i}EI Kioku, foca, você não precisa ficar remoendo isso, você já superou isso, e deve continuar assim, F O C O{/i}{/cps}"
                    menu:
                        "Ir para a estação de trêm":
                            jump tremestacao
                        "Voltar para o apartamento":
                            jump fimdemosecreto
                "Despedir-se e seguir para a estação de trêm":
                    $ stellaamizade += 10
                    k normal "{cps=40}\"Bom, eu tenho que ir agora, senão vou me atrasar pra faculdade{/cps}\""
                    hide Stella envergonhada
                    show Stella feliz
                    s feliz "{cps=40}\"Claro Kioku, muito obrigada por me ajudar com a porta{/cps}\""
                    k normal "{cps=40}\"Imagina, qualquer coisa que precisar é só me chamar{/cps}\""
                    hide Stella feliz
                    scene narrador
                    with pixellate
                    k "{cps=40}{i}Faz tempo que não sorrio continuamente assim, acho que tem algo mudando...{/i}{/cps}"
                    k "{cps=40}{i}Se bem que a mãe sempre falava que eu tinha um bom coração, talvez seja isso...{/i}{/cps}"
                    k "{cps=40}{i}A Estella parece legal....{/i}{/cps}"
                    k divertindo "{cps=40}{i}Se a Jinsei descobrir que eu conversei com a Estella, ela vai ficar.....{/i}{/cps}"
                    show JinseiCbravanime at center
                    with fade
                    j bravanime "{cps=40}\"Kioku Aida! O que você pensa que está fazendo conversando com essa garota?!{/cps}\""
                    j bravanime "{cps=40}\"Você sabe que eu não gosto que você fale com outras garotas além de mim!{/cps}\""
                    hide JinseiCbravanime
                    with fade
                    k divertindo "{cps=40}{i}Hahahahahahaha, a Jinsei sempre foi assim ciumenta, mas ela sabe que sempre vai ter um espaço pra ela, além do mais ela foi minha primeira amiga....{/i}{/cps}"
                    k triste "{cps=40}{i}...Ela foi a única que me apoiou e ficou comigo nesses últimos 10 anos...{/i}{/cps}"
                    k triste "{cps=40}{i}Sem ela não sei onde estaria hoje...{/i}{/cps}"
                    k normal "{cps=40}{i}EI Kioku, foca, você não precisa ficar remoendo isso, você já superou isso, e deve continuar assim, F O C O{/i}{/cps}"
                    menu:
                        "Ir para a estação de trêm":
                            jump tremestacao
                        "Voltar para o apartamento":
                            jump fimdemosecreto

        "Despedir-se e seguir para a estação de trêm":
            $ trematraso = False
            k normal "{cps=40}\"Bom, eu tenho que ir agora, senão vou me atrasar pra faculdade{/cps}\""
            hide Stella smug
            show Stella feliz
            s feliz "{cps=40}\"Claro Kioku, muito obrigada por me ajudar com a porta{/cps}\""
            k normal "{cps=40}\"Imagina, qualquer coisa que precisar é só me chamar{/cps}\""
            hide Stella feliz
            scene narrador
            with pixellate
            k "{cps=40}{i}Nem consegui dar tchau direito pra Estella, vou ter que correr pra não perder o trêm{/i}{/cps}"
            jump tremestacao
        

label tremestacao:
    call save_point
    "{cps=40}Kioku segue em direção a estação de trêm, tentando não se atrasar e perder o mesmo.{/cps}"
    "{cps=40}Ele sabe que se perder este trêm, ele pode perder um dos perídos da prova final, e isso pode prejudicar sua nota na matéria.{/cps}"

    if trematraso == True:
        stop music fadeout 1.0
        play music "audio/PEGAOTREMKIOKU.mp3" fadein 1.0
        call rolar_d20 (dc=20, modifier=1, titulo="Tente a Sorte: Correr para pegar o trêm", reveal_result = True) from _call_rolar_d20_1
        $ resultado = _return
        if resultado:
            $ trematraso = False
            "{cps=40}Kioku começa a correr, e utilizar toda sua energia que tinha no corpo, ele sabia que se perdesse o trêm, sua nota na prova final poderia ser prejudicada.{/cps}"
            "{cps=40}Kioku, então, pula a catraca, deixando alguns trocados para retribuir a passagem, começa a descer as escadas como um jato...\"{/cps}"
            scene estacaodetrem
            with pixellate
            "{cps=40}Ele, então, chega na plataforma, olha para os lados e.....{/cps}"
            "{cps=20}...{/cps}"
            "{cps=20}...{/cps}"
            "{cps=40}Apenas estou fazendo um momento de suspense aqui...{/cps}"
            "{cps=40}Kioku olha ao redor e....{/cps}"
            "Maquinista" "{cps=40}\"Ultima chamada para o trêm com destino a Universidade de Tokyo, embarque imediatamente\"{/cps}"
            stop music fadeout 1.0
            play music "audio/frozen_winter.mp3" fadein 1.0
            scene trem
            with pixellate
            k normal "{cps=40}\"Puta merda, consegui chegar a tempo, meu deus do céu... Deus é muito bom e o diabo não presta nem um pouco nossa\"{/cps}"
            call rolar_d20 (dc=13, modifier=0, titulo="Tente a Sorte: Tem um lugar vago?") from _call_rolar_d20_2
            $ resultado = _return
            if resultado:
                "{cps=40}Kioku começa a vasculhar cada assento possível no vagão que estava e, por sorte, ele encontra um assento em um dos cantos do vagão\(que sorte ein Kioku\).{/cps}"
                k normal "{cps=40}\"Ai, ainda bem que achei um assento, nossa senhora, to exausto... Tenho que me exercitar mais meu deus\"{/cps}"
                k normal "{cps=40}{i}Vou tentar descansar um pouco aqui, antes da prova...{/i}{/cps}"
                jump escola
            else:
                "{cps=40}Kioku começa a vasculhar cada assento possível no vagão que estava, mas infelizmente não havia mais nenhum para ele poder sentar.{/cps}"
                k bravo "{cps=40}\"Puta merda cara, vou tem que ficar 30 minutos de pé agora... se eu tivesse chegado um pouco mais cedo\"{/cps}"
                k normal "{cps=40}{i}Vou tentar descansar um pouco aqui em pé, antes da prova, espero que não freie bruscamente e eu caia no chão...{/cps}"
                "{cps=40}Não se preocupem, isso não vai acontecer{/cps}{cps=0.5}..................{/cps}"
                jump escola
        else:
            "{cps=40}Kioku começa a correr, utiliza toda a sua adrenalina, suas pernas começam a formigar, esse garoto nunca correu tanto na sua vida pra pegar um trêm.{/cps}"
            "{cps=40}Ele salta a catraca da estação, deixando algumas moedas para trás como pagamento, começa a descer as escadas como um foguete...{/cps}"
            scene estacaodetrem
            with pixellate
            "{cps=40}Ele chega na plataforma, olha para os lados e.....{/cps}"
            "{cps=20}...{/cps}"
            "{cps=20}...{/cps}"
            "{cps=40}Apenas estou fazendo um momento de suspense...{/cps}"
            "{cps=40}Kioku olha ao redor e ve que o seu trêm, começa a fechar as portas, Kioku sente que pode arriscar tudo e tentar de alguma forma adentrar na porta antes que ela feche.{/cps}"
            menu:
                "Tentar entrar no trêm":
                    call rolar_d20 (dc=19, modifier=0, titulo="Tente a Sorte: Passar pelas frestas da porta antes que ela feche") from _call_rolar_d20_3
                    $ resultado = _return
                    if resultado:
                        "{cps=40}Kioku corre em direção ao trêm, e com um salto impressionante, ele consegue entrar no trêm antes que as portas se fechassem completamente{/cps}"
                        stop music fadeout 1.0
                        play music "audio/frozen_winter.mp3" fadein 1.0
                        scene trem
                        with pixellate
                        "{cps=40}Você é muito sortudo ein, nossa, o Kioku ta nas mãos certas mesmo{/cps}"
                        k normal "{cps=40}\"Ufa... consegui entrar no trêm... nossa senhora, senti minha vida passando pelos meus olhos.... 1 erro ali e era morte na certa\"{/cps}"
                        k normal "{cps=40}{i}Não tem nenhum assento livre, que merda, bom, vou tentar descansar de pé aqui, e me escorrar nessa parede, espero que não freie bruscamente e eu caia no chão\"{/i}{/cps}"
                        "{cps=40}Não se preocupem, isso não vai acontecer..................{/cps}"
                        jump escola
                    else:
                        "{cps=40}Kioku corre em direção a porta do trêm, tenta saltar antes dela fechar, mas ele bate de cara na porta, e o trêm começa a sair.{/cps}"
                        "{cps=40}Kioku fica ali parado, vendo o trêm se afastar, ele sente uma mistura de raiva e frustração, ele sabia que tinha que chegar a tempo, mas não conseguiu.{/cps}"
                        stop music fadeout 1.0
                        play music "audio/frozen_winter.mp3" fadein 1.0
                        k bravo "{cps=40}\"Merda... eu perdi o trêm... que porra de dia é esse meu deus... agora vou me fuder na prova final... nossa senhora\"{/cps}"
                        k bravo "{cps=40}{i}Foda-se... vou ter que esperar o próximo trêm... que merda...{/i}{/cps}"
                        "{cps=40}Kioku então se afasta da plataforma, indo para a sala de espera, e se senta, esperando o próximo trêm chegar.{/cps}"
                        "{cps=40}Depois de 30 minutos, o próximo trêm chega, Kioku entra no vagão, e procura um assento vago para se sentar, e facilmente ele o encontra.{/cps}"
                        scene trem
                        with pixellate
                        k bravo "{cps=40}{i}Finalmente consegui entrar no trêm... eu espero que não me atrase muito na prova final... nossa senhora...{/i}{/cps}"
                        k normal "{cps=40}{i}Vou tentar descansar um pouco aqui, antes da prova...{/i}{/cps}"
                        jump escola 
                "Desistir e esperar o próximo trêm":
                    stop music fadeout 1.0
                    play music "audio/frozen_winter.mp3" fadein 1.0
                    "{cps=40}Kioku vê que o trêm está prestes a fechar as portas, e decide não arriscar sua vida tentando entrar na porta, ele se afasta da plataforma, indo para a sala de espera, e se senta, esperando o próximo trêm chegar.{/cps}"
                    "{cps=40}Depois de 30 minutos, o próximo trêm chega, Kioku entra no vagão, e procura um assento vago para se sentar, e facilmente ele o acha.{/cps}"
                    scene trem
                    with pixellate
                    k bravo "{cps=40}{i}Porra do caralho, vou me atrasar pra prova, que merda de dia é esse ein...{/i}{/cps}"
                    k normal "{cps=40}{i}Vou tentar descansar um pouco aqui, antes da prova...{/i}{/cps}"
                    jump escola
    else:
        "{cps=40}Kioku chega na estação de trêm com tempo de sobra, ele entra no vagão, e procura um assento vago para se sentar, e rapidamente o encontra.{/cps}"
        scene trem
        with pixellate
        k normal "{cps=40}\"Ufa... consegui chegar a tempo, meu deus do céu... Deus é muito bom e o diabo não presta mesmo\"{/cps}"
        k normal "{cps=40}{i}Vou tentar descansar um pouco aqui, antes da prova...{/i}{/cps}"
        jump escola

label escola:
    scene narrador
    with dissolve
    show Cap1 at center
    with dissolve 
    pause 2.0
    scene entradaescoladia
    with pixellate
    if trematraso == True:
        jump discussaoatraso
    else:
        k normal "{cps=40}{i}Cheguei a tempo, que bom, não preciso me preocupar em ter me atrasado{/i}{/cps}"
        k normal "{cps=40}{i}Vou estudar mais um pouco para poder ir bem na prova{/i}{/cps}"
        scene biblioteca1
        with pixellate
        k normal "{cps=40}{i}Ah, único lugar onde posso ter paz, essa hora ninguém aparece aqui, então posso estudar mais, bom, vamo lá{/cps}"
        scene narrador
        with dissolve
        "{cps=40}Kioku começa a estudar, revisa cada conteúdo que irá cair na sua prova, casa centímetro, porque ele sabe, mesmo que pouca nota, mas que a prova final de seu professor, é sempre a mais díficil{/cps}"
        "{cps=40}Se passam alguns minutos, e durante os estudos Kioku acaba dormindo no meio{/cps}"
        scene biblioteca2
        with pixellate
        "???" "{cps=40}Vamos acordar bela adormecida....{/cps}"
        k normal "{cps=40}Hã? Quem? Onde?{/cps}"
        show Subaru sorisso
        with dissolve
        "???" "{cps=40}O que foi Kioku? Perdeu alguma coisa?"
        k normal "{cps=40}Só me faltava essa, o que você quer Subaru{/cps}"
        jump discussao

label discussao:
    hide Subaru sorisso
    show Subaru sorisso
    si sorisso "{cps=40}\"Ei, relaxa mano, só vim acordar você.... Além do mais, você tem uma prova a fazer não? haha\"{/cps}"
    k bravo "{cps=40}Merda.... dormi demais, sai da minha frente Subaru...{/cps}"
    si sorisso "{cps=40}\"Olha como fala com o presidente do clube ein Kioku, dois toques você toma advertência\"{/cps}"
    k bravo "{cps=40}\"Caguei pra sua presidência, sai da minha frente Subaru\"{/cps}"
    k bravo "{cps=40}\"Por favor, eu to atrasado pra prova final, eu não tenho tempo pra perder contigo hoje, sai fora{/cps}\""
    hide Subaru sorisso
    show Subaru bravo1
    si bravo1 "{cps=40}\"Você só vai sair daqui quando eu disser Kioku{/cps}\""
    menu:
        "Confrontar Subaru":
            $ subarusangue = True
            k irritado "{cps=40}\"Escuta aqui Subaru Ichida do caralho, eu tenho uma prova que é importante pra mim, eu to cagando se tu não quer nada com nada nessa vida, agora sai da minha frente{/cps}\""
            hide Subaru bravo1
            show Subaru bravo2
            si bravo2 "{cps=40}\"Escuta aqui Kioku, você tem que respeitar a hierarquia do clube, eu sou o presidente do grêmio estudantil, e você apenas um aluno, dois toques e você pode ir tomar uma suspensão{/cps}\""
            k irritado "{cps=40}\"Que porra de hierarquia é essa Subaru? Eu não to nem ai em você ser o presidente, eu só quero ir pra minha sala de aula, agora sai da minha frente antes que eu perca a paciência de vez{/cps}\""
            hide Subaru bravo2
            show Subaru irritado
            si irritado "{cps=40}\"Você quer mesmo arriscar Kioku, o que sua mamãzinha falaria se fosse suspenso? Ou nem da sua mãe você se lembra haha...\""
            menu:
                "SOCAR A PORRA DO SUBARU":
                    stop music fadeout 1.0
                    play music "audio/kiokumente.mp3" fadein 1.0
                    scene narrador
                    with dissolve
                    "???" "{cps=40}{i}Kioku, você sabe o que fazer....{/i}{/cps}"
                    "???" "{cps=40}{i}Ele merece conhecer o verdadeiro Kioku Aida, mostre a ele quem você é{/i}{/cps}"
                    "???" "{cps=40}{i}Ele merece a morte.... E você é ELA, mostre que não se deve mecher com a morte{/i}{/cps}"
                    "{cps=40}Kioku cerra os punhos, encara Subaru nos fundos dos olhos, com aquele sorriso debochado, e então, Kioku pega Subaru pelo pescoço{/cps}"
                    "{cps=40}Ele o ergue do chão, Subaru começa a se debater, tentando se soltar, mas Kioku o segura firme, como se fosse nada....{/cps}"
                    "{cps=40}E então, com sua mão, ele começa....{/cps}"
                    $ renpy.music.set_volume(0.3, delay=0.5, channel='music')
                    "1"
                    play audio "audio/soco.mp3"
                    "2"
                    play audio "audio/soco2.mp3"
                    "3"
                    play audio "audio/soco1.mp3"
                    "4"
                    play audio "audio/soco.mp3"
                    "5"
                    play audio "audio/soco2.mp3"
                    "6"
                    play audio "audio/soco1.mp3"
                    "{cps=40}Naquele momento Kioku perdeu as contas de quantos socos ele deu em Subaru, era como se tudo ao redor tivesse parado, e a única coisa que existia era ele e Subaru....{/cps}"
                    "{cps=40}Kioku não sentia dor, não sentia cansaço, tudo que ele sentia era uma raiva incontrolável, uma vontade de fazer Subaru pagar por tudo que ele fez....{/cps}"
                    "{cps=40}E assim, Kioku continua"
                    play audio "audio/combosoco.mp3"
                    pause 6.0
                    $ renpy.music.set_volume(1.0, delay=0.5, channel='music')
                    "{cps=40}Kioku finalmente para, ele não sabe por quanto tempo bateu no rost de Subaru, ele só sabe que antes era uma pessoa que se debatia em seu braço{/cps}"
                    "{cps=40}Agora era um corpo sendo segurado como se fosse carne, onde era para ser seu rosto, apenas um buraco afundado irreconhecível{/cps}"
                    "{cps=40}Kioku larga o que um dia era o corpo de Subaru, seus punhos pingando sangue, suas falanges completamente enroxadas, ele olha para frente{/cps}"
                    "{cps=40}E um grande sorisso toma conta de seu rosto, aquele sangue nas suas mãos, lhe fazia bem, ele recebeu o que merecia{/cps}"
                    "{cps=40}Por um segundo, então, Kioku fecha os olhos e respira fundo{/cps}"
                    jump oquerealmenteaconteceu2

                "Socar Subaru":
                    stop music fadeout 1.0
                    play music "audio/kiokumente.mp3" fadein 1.0
                    "{cps=40}Kioku fecha seus punhos, é como se tudo ao redor ficasse lento, vendo Subaru Ichida na sua frente, rindo dele, e de sua situação....{/cps}"
                    "???" "{cps=40}{i}Ele ri de você Kioku, como se você fosse ninguém, ele ri da sua situação, ri de seus parentes, você vai mesmo deixar ele te tratar dessa forma?{/i}{/cps}"
                    "???" "{cps=40}{i}Não..... você não vai deixar isso acontecer.... VOCÊ NÃO PODE DEIXAR ISSO ACONTECER{/i}{/cps}"
                    "???" "{cps=40}{i}ELE RI DE VOCÊ.... ELE ZOA DA SUA SITUAÇÃO..... ELE RI DA SUA FAMILIA, AMIGOS E DE TODO MUNDO....{/i}{/cps}"
                    "???" "{cps=40}{i}{size=+10}ELE{/size} {size=+15}TEM{/size} {size=+20}QUE{/size} {size=+25}PAGAR....{/size}{/i}{/cps}"
                    scene narrador
                    "{cps=40}Tudo ficou escuro na visão de Kioku, unica coisa que ele conseguia ouvir era....{/cps}"
                    $ renpy.music.set_volume(0.3, delay=0.5, channel='music')
                    play sound "audio/SocoKioku.mp3" loop
                    "{cps=40}De novo....{/cps}"
                    "{cps=40}De novo....{/cps}"
                    "{cps=40}De novo....{/cps}"
                    "{cps=40}E de novo...{/cps}"
                    "{cps=40}Até que.....{/cps}"
                    stop sound fadeout 1.0
                    $ renpy.music.set_volume(1.0, delay=0.5, channel='music')
                    "{cps=40}Kioku para de bater.... suas mãos encharcadas de sangue....{/cps}"
                    "???" "{cps=40}{i}É bom né Kioku, esse sentimento.... de Prazer ao ver alguêm {size=+10}DESPREZIVEL{/sizel} como ele no chão...{/i}{/cps}"
                    "???" "{cps=40}{i}Olha para ele.... no chão..... seu rosto todo sangrento, ele não fica bem assim? Esse é o lugar que ele merece ficar....{/i}{/cps}"
                    "???" "{cps=40}{i}Agora pega a cabeça dele, mostra pra ele quem manda aqui Kioku, finaliza ele assim como você fez no passado.... Eu sei que você quer....{/i}{/cps}"
                    "???" "{cps=40}{i}Porque você ta parado Kioku? Vamos, eu sei que você queria ele bem pior do que ja está, e eu sei.... Que você consegue fazer ele ficar pior{/i}{/cps}"
                    "???" "{cps=40}{i}{size=+25}VAMOS KIOKU, MOSTRE PARA ELE COM QUEM ELE TA MECHENDO, MOSTRA PRA ELE QUEM É KIOKU AIDA{/size}{/i}{/cps}"
            menu:
                "Finalizar Subaru":
                    "{cps=40}Kioku pega Subaru pelo cabelo, como se não fosse nada, apenas uma carne que retirou do freezer....{/cps}"
                    "{cps=40}Olha para ele, ainda consciente, seus olhos marejados de dor, pedindo por qualquer perdão.....{/cps}"
                    "{cps=40}Mas Kioku não queria saber sobre perdoa-lo....{/cps}"
                    "{cps=40}Única coisa que passava pela cabeça de Kioku era que Subaru não sofreu o suficiente{/cps}"
                    "{cps=40}Kioku então, joga Subaru no chão que grita de dor pelo impacto, o mesmo começa a gritar por socorro, com sua voz fraca por estar se engasgando com seu próprio sangue....{/cps}"
                    "{cps=40}Kioku olha para Subaru, seus olhos que agora eram olhos vazios, completamente pretos....{/cps}"
                    k morte "{cps=40}Odeio gente barulhenta...{/cps}"
                    play audio "audio/headbreak.mp3"
                    "{cps=40}Kioku esmaga a cabeça de Subaru contra o chão, o som da cabeça rompendo, seus ossos quebrando, aquele não era mais o Kioku....{/cps}"
                    jump oquerealmenteaconteceu2
                "FINALIZAR SUBARU":
                    "{cps=40}Kioku pega Subaru pelo cabelo, como se não fosse nada, apenas uma carne que retirou do freezer....{/cps}"
                    "{cps=40}Olha para ele, ainda consciente, seu rosto parecia distorcido, seus olhos marejados de dor, rindo e pedindo por mais.....{/cps}"
                    "{cps=40}Kioku sabia que aquele não era o Subaru, mas ele não reclamava, porque ele queria realmente fazer Subaru sofrer mais...{/cps}"
                    "{cps=40}Kioku olha nos fundos dos olhos de Subaru, o joga no chão com toda sua força, e se ajoelha por cima dele{/cps}"
                    "{cps=40}Cerra seus punhos, prontos para mais um round.... e então, Kioku começa...{/cps}"
                    "1"
                    "2"
                    "3"
                    "4"
                    "5"
                    "6"
                    "7"
                    "{cps=40}....{/cps}"
                    "{cps=40}Kioku ja perdeu as contas, apenas continuava, até ele não poder mais....{/cps}"
                    "{cps=40}Então, ele continua, de novo...{/cps}"
                    $ renpy.music.set_volume(0.3, delay=0.5, channel='music')
                    play audio "audio/soco.mp3"
                    "{cps=40}De novo....{/cps}"
                    play audio "audio/soco1.mp3"
                    "{cps=40}De novo....{/cps}"
                    play audio "audio/soco2.mp3"
                    "{cps=40}E de novo...{/cps}"
                    play audio "audio/combosoco.mp3"
                    pause 6.0
                    $ renpy.music.set_volume(1.0, delay=0.5, channel='music')
                    "{cps=40}Kioku da o seu último soco, com suas mãos pingando a sangue, seus punhos roxos de tanto bater, ele finalmente para....{/cps}"
                    "{cps=40}E então, quando olha para o que restou de Subaru, onde era para ser seu rosto, apenas muitos hematomas, e um rosto irreconhecível...{/cps}"
                    "{cps=40}Kioku se levanta, com um grande suspiro, e um alivio junto ao um sentimento bom em seu peito...{/cps}"
                    "???" "{cps=40}{i}Isso Kioku, é isso que ele merece, alguem fraco como ele, não merece seu perdão, você mostrou a ele o {size=+10}SEU{/size} lugar{/i}{/cps}"
                    "{cps=40}Kioku respira fundo, ele então fecha os olhos por um momento e abre-os novamente processando tudo isso{/cps}"
                    stop music fadeout 1.0
                    jump oquerealmenteaconteceu2
        "ignorar ele":
            k normal "{cps=40}\"Fala o que você quiser Subaru, eu tenho uma vida pela frente, não quero você atrapalhando ela{/cps}"
            hide Subaru irritado
            with dissolve
            "{cps=40}Kioku passa pelo Subaru que da um encontro de ombros nele de propósito, e então, começa a seguir em direção a sua sala{/cps}"
            jump provafinal

label discussaoatraso:
    k triste "{cps=40}{i}Cheguei na faculdade atrasado... não tem ninguem no pátio, e pela janela parece que ninguém nos corredores, meu deus do céu eu tenho que correr{/i}{/cps}"
    k normal "{cps=40}{i}Vou correr para a sala de aula o mais rápido possível, quem sabe eu não consiga c\"{/i}{/cps}{nw}"
    pause 0.5
    "???" "{cps=40}\"Aonde vai com tanta pressa Kioku? Perdeu o trem foi haha?{/cps}\""
    k bravo "{cps=40}{i}Merda... não é possivel que esse cara ainda ta aqui, porque caralhos ele não ta na aula dele?{/i}{/cps}"
    show Subaru sorisso
    with dissolve
    si sorisso "{cps=40}\"Ei, Kioku, espera, não precisa ter tanta pressa assim haha\""
    k bravo "{cps=40}\"Não começa Subaru, por favor, eu to atrasado pra prova final, eu não tenho tempo pra perder contigo hoje, sai fora{/cps}\""
    hide Subaru sorisso
